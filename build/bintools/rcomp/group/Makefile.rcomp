CXX ?= g++

BLDDIR = ../build
SRCDIR = ../src
INCDIR = ../inc

UPPER_SOURCE = ARRAY.CPP ASTRING.CPP CCODES.CPP CTABLE.CPP \
	DATATYPE.CPP ERRORHAN.CPP FILEACC.CPP FILELINE.CPP \
	INDEXTAB.CPP LINKLIST.CPP MEM.CPP NAMEIDMA.CPP NUMVAL.CPP \
	RCBINSTR.CPP RCOSTRM.CPP RCSCAN.CPP RCSTACK.CPP RESOURCE.CPP \
	STACK.CPP STRINGAR.CPP STRUCTST.CPP UNICODE_COMPRESSOR.CPP \
	QUALIFAR.CPP

# rcomp.cpp, rcomp.hpp and rcompl.cpp are the checked-in parser sources.  They
# deliberately remain inputs: regenerating them with a modern Bison/Flex can
# change the accepted grammar and the generated resource output.
LOWER_SOURCE = main.cpp localise.cpp messages.cpp rcomp.cpp rcompl.cpp

OBJECT = $(addprefix $(BLDDIR)/, \
	$(UPPER_SOURCE:.CPP=.o) $(LOWER_SOURCE:.cpp=.o))
DEPS = $(OBJECT:.o=.d)
TARGET = $(BLDDIR)/rcomp

RCOMP_ARCH_FLAGS ?= -m32
RCOMP_STD ?= -std=gnu++98
RCOMP_CPPFLAGS = -D__LINUX__ -D__TOOLS2__ -I$(INCDIR) -I$(SRCDIR)
RCOMP_CXXFLAGS = $(RCOMP_ARCH_FLAGS) $(RCOMP_STD) -MMD -MP
RCOMP_LDFLAGS = $(RCOMP_ARCH_FLAGS)

.PHONY: all clean test

all: $(TARGET)

$(TARGET): $(OBJECT)
	$(CXX) $(LDFLAGS) $(RCOMP_LDFLAGS) $^ $(LDLIBS) -o $@

$(BLDDIR):
	mkdir -p "$@"

$(BLDDIR)/%.o: $(SRCDIR)/%.CPP | $(BLDDIR)
	$(CXX) $(CPPFLAGS) $(RCOMP_CPPFLAGS) $(CXXFLAGS) $(RCOMP_CXXFLAGS) -c "$<" -o "$@"

$(BLDDIR)/%.o: $(SRCDIR)/%.cpp | $(BLDDIR)
	$(CXX) $(CPPFLAGS) $(RCOMP_CPPFLAGS) $(CXXFLAGS) $(RCOMP_CXXFLAGS) -c "$<" -o "$@"

clean:
	rm -f $(OBJECT) $(DEPS) $(TARGET)
	-rmdir $(BLDDIR)

test: $(TARGET)
	bash ./test-rcomp.sh "$(abspath $(TARGET))"

-include $(DEPS)
